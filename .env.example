# Phase 1 (data layer) needs no secrets — Binance public endpoints only.
# The following are for later phases; leave unset until you reach them.

# Phase 3 — Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — separates `recommend` (manual-trading advisory alerts) from the
# shadow-run chat above. Falls back to TELEGRAM_CHAT_ID if unset.
TELEGRAM_RECO_CHAT_ID=

# Phase 5 — Quidax execution (trading scope only, no withdrawal permission)
QUIDAX_API_KEY=
QUIDAX_API_SECRET=
